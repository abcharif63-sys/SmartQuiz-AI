<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A14"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Emoji résultat -->
        <TextView
            android:id="@+id/resultEmoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎉"
            android:textSize="52sp"
            android:layout_marginBottom="12dp"/>

        <!-- Message principal -->
        <TextView
            android:id="@+id/resultMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Excellent travail!"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#F0EEFF"
            android:gravity="center"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/resultSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tu maîtrises bien ce chapitre."
            android:textSize="13sp"
            android:textColor="#A09AC5"
            android:gravity="center"
            android:layout_marginBottom="28dp"/>

        <!-- Score circulaire (simulé avec ProgressBar) -->
        <FrameLayout
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_marginBottom="28dp">

            <ProgressBar
                android:id="@+id/scoreCircle"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:progressDrawable="@drawable/circular_progress"
                android:max="100"
                android:progress="0"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/scorePct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="#F0EEFF"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Score final"
                    android:textSize="11sp"
                    android:textColor="#6B6491"/>
            </LinearLayout>
        </FrameLayout>

        <!-- Breakdown stats -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="12dp"
                android:gravity="center"
                android:layout_marginEnd="6dp">
                <TextView
                    android:id="@+id/resCorrect"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#34D399"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Correctes"
                    android:textSize="11sp"
                    android:textColor="#6B6491"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="12dp"
                android:gravity="center"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp">
                <TextView
                    android:id="@+id/resWrong"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#F87171"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Incorrectes"
                    android:textSize="11sp"
                    android:textColor="#6B6491"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="12dp"
                android:gravity="center"
                android:layout_marginStart="6dp">
                <TextView
                    android:id="@+id/resTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#A78BFA"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total"
                    android:textSize="11sp"
                    android:textColor="#6B6491"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Révision des réponses -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RÉVISION DES RÉPONSES"
            android:textSize="11sp"
            android:textColor="#6B6491"
            android:letterSpacing="0.1"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:id="@+id/reviewList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp"/>

        <!-- Boutons actions -->
        <Button
            android:id="@+id/btnRetryWrong"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="🔁  Reprendre les erreurs"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/btn_primary_bg"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btnBackHome"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="← Retour à l'accueil"
            android:textColor="#A09AC5"
            android:textSize="14sp"
            android:background="@drawable/btn_ghost_bg"/>

    </LinearLayout>
</ScrollView>
